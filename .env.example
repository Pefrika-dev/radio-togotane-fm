# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radio_togotane?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Initial Admin (used by seed script)
ADMIN_EMAIL="admin@radiotogotane.co.ke"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Station Administrator"
